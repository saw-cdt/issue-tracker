<h1>Issue Tracker</h1>
<%= form_with model: @issue do |form| %>

  <%= form.label :title %>
  <%= form.text_field :title %>
  <br>

  <%= form.label :description %>
  <%= form.text_area :description %>
  <br>

  <%= form.label :status %>
  <%= form.select :status, ["open","closed"]%>
  <br>

  <%= form.label :priority %>
  <%= form.select :priority, ["low", "mid", "high"] %>
  <br>

  <%= form.submit "Create Issue" %>
<% end %>
